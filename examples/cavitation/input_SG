# AMR grid
Base nx   : 32
Base ny   : 32
Base nz   : 1
Max level : 2

# Regridding parameters
Regrid nsteps     : 10
Tagging vorticity : 5
Tagging rho ratio : 1.5
Tagging divergence : 1e3   ! [1/s] fraction of peak pulse divergence (2*Pulse amplitude = 1e4)

# Mesh definition
Lx : 0.1
Ly : 0.1

# Flow setup
Liquid temperature            : 350
Liquid pressure               : 1e5
!Exit velocity                 : 30
!Core velocity                 : 50
Pulse amplitude               : 5000   ! [1/s] Ur(r)=Pulse amplitude*r*exp(-(r/Pulse radius)^2)
Pulse radius                  : 0.02   ! [m] sets size of initial depressurized/cavitating region
Boundary condition            : wall   ! dirichlet=cavitation only, wall=cavitation+condensation
Cavitation pressure threshold : -1e8
Condensation temperature tolerance : 0   ! [K] nucleate liquid only when TG < Tsat-this; 0=nucleate at Tsat (old behavior)
Initial vapor mass fraction   : 0

# Fluid properties
Liquid viscosity            : 9e-4
Liquid Prandtl number       : 0
Gas viscosity               : 1.27e-5
Gas Prandtl number          : 0

# EOS parameters (Flatten & Lund 2011, range 300-500 K)
Liquid EOS type                                  : SG
Relaxation type                                  : pTg
Liquid specific heat capacity at constant volume : 1816
Liquid specific heat capacity ratio              : 2.35
Liquid reference energy shift                    : -1167000
Liquid reference entropy shift                   : 0
Liquid stiffening pressure                       : 1e9
Vapor specific heat capacity at constant volume  : 1040
Vapor specific heat capacity ratio               : 1.43
Vapor reference energy shift                     : 2030000
Vapor reference entropy shift                    : -23400
Air specific heat capacity at constant volume    : 718
Air specific heat capacity ratio                 : 1.4
Air reference energy shift                       : 0
Air reference entropy shift                      : 0

# Time integration
Max dt     : 5e-8
Initial dt : 1e-8
Max CFL    : 0.5
Max time   : 8e-6

# Output
Output period     : 2.5e-7
!Checkpoint period : 4.10000E-06
!Restart from      : 1.00000E-05
