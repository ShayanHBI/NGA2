# AMR grid
Base nx       : 2000 ! 5000
Base ny       : 1
Base nz       : 1
Max level     : 0
Domain length : 1

# Regridding parameters (inert at Max level 0)
Regrid nsteps      : 10
Tag density error  : 0.6
Tag pressure error : 0.3
Tag Ducros value   : 0.5

# Initial state: pure liquid, velocity -u left and +u right of the expansion location
Initial pressure    : 1e5
Initial temperature : 353
Expansion velocity  : 2
Expansion location  : 0.5

# EOS: Pelanti 2022 Table 3 (NASG water, ideal-gas vapor); air is the zero-mass carrier
Liquid gamma    : 1.187
Liquid pinf     : 7.028e8
Liquid covolume : 6.61e-4
Liquid cv       : 3610
Liquid q        : -1177788
Liquid qp       : 0
Vapor gamma     : 1.467
Vapor cv        : 955
Vapor q         : 2077616
Vapor qp        : 14317
Air gamma       : 1.4
Air cv          : 718

# Relaxation
Relaxation type                    : pTg
VF relaxation band                 : 1
Cavitation pressure threshold      : 0 ! 1e30
Condensation temperature tolerance : 50 ! 0
! Mechanical relaxation rate       : 1.0
! Thermal relaxation rate          : 2000
! Chemical relaxation rate         : 1e-4

# Transport properties and subgrid models (physical transport off)
Liquid viscosity                      : 0
Gas viscosity                         : 0
Liquid thermal conductivity           : 0
Gas thermal conductivity              : 0
Artificial bulk viscosity coefficient : 5
Artificial viscosity coefficient      : 0
Use Vreman                            : .false.
Surface tension                       : 0

# Time integration
Max dt     : 1.5e-7 ! 6e-8
Max CFL    : 0.5
Max time   : 3e-3

# Output
Output period     : 5e-5
Checkpoint period : 5e-4
Restart from      : !5.00100E-04