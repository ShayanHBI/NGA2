# Water cavitation tube (Pelanti 2022, Sec. 8.2.1), SI units, starting from pure liquid

# AMR grid
Base nx       : 2000 ! 5000
Base ny       : 1
Base nz       : 1
Max level     : 0
Domain length : 1

# Regridding parameters (inert at Max level 0)
Regrid nsteps      : 10
Tag density error  : 0.6
Tag pressure error : 0.3
Tag Ducros value   : 0.5

# Initial state: pure liquid, velocity -u left and +u right of the expansion location
Initial pressure    : 1e5
Initial temperature : 353
Expansion velocity  : 2
Expansion location  : 0.5

# EOS: Pelanti 2022 Table 3 (NASG water, ideal-gas vapor); air is the zero-mass carrier
Liquid gamma    : 1.187
Liquid pinf     : 7.028e8
Liquid covolume : 6.61e-4
Liquid cv       : 3610
Liquid q        : -1177788
Liquid qp       : 0
Vapor gamma     : 1.467
Vapor cv        : 955
Vapor q         : 2077616
Vapor qp        : 14317
Air gamma       : 1.4
Air cv          : 718

# Relaxation (p, pT, pThybrid, pTg)
Relaxation type : pTg
# Liquid pressure [Pa] below which a pure-liquid cell cavitates; condensation tolerance [K]
Cavitation pressure threshold      : 0 ! 1e30
Condensation temperature tolerance : 50 ! 0
# Finite relaxation rates (Pelanti 2022); omit a line for instantaneous
# Mechanical relaxation rate : 1.0
# Thermal relaxation rate    : 2000
# Chemical relaxation rate   : 1e-4

# Overshoot safety rules (0: off)
# Relax skip gas density         : 0
# Relax sliver gas fraction      : 0
# Relax liquid thermal tolerance : 0
# Relax vapor fraction tolerance : 0
Relax vacuum pressure ratio    : 0

# Relaxation clustering
Mechanical clustering : .false.
Thermal clustering    : .false.
Chemical clustering   : .false.
Dissolve stranded gas : .false.

# Transport properties and subgrid models (physical transport off)
Liquid viscosity                 : 0
Gas viscosity                    : 0
Liquid thermal conductivity      : 0
Gas thermal conductivity         : 0
# Artificial bulk viscosity (0: off); the second coefficient is the shear-to-bulk ratio
Artificial bulk viscosity coefficient : 5
Artificial viscosity coefficient : 0
Use Vreman                       : .false.
Surface tension                  : 0

# Time integration
Max dt     : 1.5e-7 ! 6e-8
Max CFL    : 0.5
Max time   : 3e-3

# Output
Output period     : 5e-5
Checkpoint period : 5e-4
Restart from      : !5.00100E-04